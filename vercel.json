{
  "rewrites": [
    { "source": "/", "destination": "https://presence-authentique-site.vercel.app/application/" },
    { "source": "/styles.css", "destination": "https://presence-authentique-site.vercel.app/styles.css" },
    { "source": "/config.js", "destination": "https://presence-authentique-site.vercel.app/config.js" },
    { "source": "/main.js", "destination": "https://presence-authentique-site.vercel.app/main.js" },
    { "source": "/js/:path*", "destination": "https://presence-authentique-site.vercel.app/js/:path*" },
    { "source": "/data/:path*", "destination": "https://presence-authentique-site.vercel.app/data/:path*" },
    { "source": "/assets/:path*", "destination": "https://presence-authentique-site.vercel.app/assets/:path*" },
    { "source": "/((?!assets/).*)", "destination": "/app.html" }
  ]
}
